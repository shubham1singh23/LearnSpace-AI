# Copy to .env. Never commit real credentials. No VITE_* secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data

# Local PostgreSQL only. Replace this development-only password in BOTH values.
POSTGRES_USER=learnspace
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=learnspace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://learnspace:local-development-only@127.0.0.1:5432/learnspace?schema=public

# Optional text generation defaults. Calls occur only after explicit user actions.
# Image configuration fields are reserved; image generation is not implemented.
LEARNSPACE_TEXT_PROVIDER=
LEARNSPACE_TEXT_MODEL=
LEARNSPACE_IMAGE_PROVIDER=
LEARNSPACE_IMAGE_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Integration tests require a SEPARATE, migrated database and explicit opt-in.
# TEST_DATABASE_URL=postgresql://learnspace:local-development-only@127.0.0.1:5432/learnspace_test?schema=public
